{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "exhibitions",
  "type": "object",
  "required": ["exhibitions"],
  "properties": {
    "exhibitions": { "type": "array", "items": { "$ref": "#/$defs/exhibition" } },
    "archive_thumbnails": {
      "type": "object",
      "required": ["tabs"],
      "properties": {
        "tabs": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["gallery_id", "label_he", "label_en", "thumbs"],
            "properties": {
              "gallery_id": { "type": "string" },
              "label_he": { "type": "string" },
              "label_en": { "type": "string" },
              "active": { "type": "boolean" },
              "thumbs": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": ["image", "exhibition_id"],
                  "properties": {
                    "n": { "type": "string" },
                    "image": { "type": "string" },
                    "exhibition_id": { "type": "string" },
                    "title_he": { "type": "string" }
                  }
                }
              }
            }
          }
        }
      }
    }
  },
  "$defs": {
    "date": { "type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$" },
    "text_block": {
      "type": "object",
      "required": ["weight", "lines"],
      "properties": {
        "weight": { "type": "string" },
        "lines": { "type": "array", "items": { "type": "string" } }
      }
    },
    "exhibition": {
      "type": "object",
      "required": ["id", "slug", "title_he", "title_en", "status", "gallery_id", "start_date", "end_date", "hero_image", "artists"],
      "properties": {
        "id": { "type": "string" },
        "slug": { "type": "string" },
        "label_en": { "type": "string" },
        "volume_en": { "type": "string" },
        "title_he": { "type": "string" },
        "title_en": { "type": "string" },
        "subtitle_he": { "type": ["string", "null"] },
        "status": { "type": "string" },
        "status_label_en": { "type": "string" },
        "gallery_id": { "type": "string" },
        "gallery_label_he": { "type": "string" },
        "curator_slug": { "type": "string" },
        "curator_card_image": { "type": "string" },
        "hero_letter_heading_en": { "type": "string" },
        "start_date": { "$ref": "#/$defs/date" },
        "end_date": { "$ref": "#/$defs/date" },
        "hero_image": { "type": "string" },
        "hero_overlay_en_only": { "type": "boolean" },
        "hero_overlay_hide_en": { "type": "boolean" },
        "gallery_images": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["src", "alt"],
            "properties": { "src": { "type": "string" }, "alt": { "type": "string" } }
          }
        },
        "thumbnails": { "type": "array" },
        "description_he": { "type": "array", "items": { "$ref": "#/$defs/text_block" } },
        "artists": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["name_en", "thumb"],
            "properties": {
              "name_en": { "type": "string" },
              "thumb": { "type": "string" },
              "slug": { "type": "string" },
              "artist_page_slug": { "type": "string" },
              "focus": { "type": "string" }
            }
          }
        },
        "figma_node_desktop": { "type": "string" },
        "figma_node_mobile": { "type": "string" }
      }
    }
  }
}
