{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "site",
  "type": "object",
  "required": ["brand", "nav", "footer"],
  "properties": {
    "brand": {
      "type": "object",
      "required": ["name_en", "name_he", "logo"],
      "properties": {
        "name_en": { "type": "string" },
        "name_he": { "type": "string" },
        "tagline_en": { "type": "string" },
        "founder": { "type": "string" },
        "logo": { "type": "string" }
      }
    },
    "nav": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["key", "label_en", "href"],
        "properties": {
          "key": { "type": "string" },
          "label_en": { "type": "string" },
          "href": { "type": "string" }
        }
      }
    },
    "footer": {
      "type": "object",
      "properties": {
        "newsletter": {
          "type": "object",
          "properties": {
            "title": { "type": "string" },
            "placeholder": { "type": "string" },
            "cta": { "type": "string" }
          }
        },
        "links_he": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["label", "href"],
            "properties": { "label": { "type": "string" }, "href": { "type": "string" } }
          }
        },
        "social": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["platform", "url"],
            "properties": { "platform": { "type": "string" }, "url": { "type": "string" } }
          }
        },
        "copyright": { "type": "string" }
      }
    },
    "announcement": { "type": "string" },
    "contact": {
      "type": "object",
      "properties": { "instagram_handle": { "type": "string" } }
    }
  }
}
